{
  "name": "prompt-info",
  "version": "1.0.0",
  "private": true,
  "description": "Prompt Info - LLM token counter and cost calculator.",
  "author": "Jonathan R. Reed",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler pages dev out --port 4173 --compatibility-date=2026-08-04",
    "preview:cloudflare": "wrangler pages dev out --port 4173 --compatibility-date=2026-08-04",
    "lint": "eslint .",
    "test": "bun test --path-ignore-patterns='tests/e2e/**'",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "analyze": "next experimental-analyze",
    "assets:social": "bun scripts/generate-social-card.mjs"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
