{
  "name": "prompt-info",
  "version": "1.0.0",
  "private": true,
  "description": "Prompt Info - LLM token counter and cost calculator.",
  "author": "Jonathan R. Reed",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node --test tests/seo-export.node.mjs",
    "start": "wrangler pages dev out --port 4173 --compatibility-date=2026-08-04",
    "preview:cloudflare": "wrangler pages dev out --port 4173 --compatibility-date=2026-08-04",
    "lint": "eslint . && oxlint --threads=1 .",
    "test": "bun test lib/*.test.ts components/charts/chartFormat.test.ts && bun test tests/api-adapters.test.ts && bun test tests/unit/*.test.mjs && bun test tests/lint/lint-coverage.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "analyze": "next experimental-analyze",
    "assets:social": "bun scripts/generate-social-card.mjs",
    "audit": "bun scripts/dependency-audit.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "gpt-tokenizer": "4.0.0",
    "lucide-react": "^1.57.0",
    "motion": "^13.5.1",
    "next": "16.4.3",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "4.10.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "oxlint": "1.81.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
